@model List<AgenticFactory.Web.Services.AuditLogVm>
@{
    ViewData["Title"] = "Audit";
}

<div class="mb-4">
    <h2 class="mb-1">Journal d'audit</h2>
    <p class="text-muted mb-0">Actions sensibles de l'organisation (Admin).</p>
</div>

<div class="af-card">
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead><tr><th>Date</th><th>Action</th><th>Acteur</th><th>Ressource</th></tr></thead>
            <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td class="small text-muted">@row.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                    <td><code>@row.Action</code></td>
                    <td>@(row.ActorEmail ?? "—")</td>
                    <td>@(row.ResourceType) @(row.ResourceId)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
